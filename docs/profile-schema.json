{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/denryoku/profile-schema.json",
  "title": "Mac Power Tiers Profiles",
  "type": "object",
  "required": ["profiles"],
  "properties": {
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "controls", "targets", "experimental"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "description": {
            "type": "string"
          },
          "controls": {
            "type": "object",
            "properties": {
              "lowPowerMode": {
                "type": "boolean",
                "description": "Maps to pmset lowpowermode where supported."
              },
              "displaySleepMinutes": {
                "type": "integer",
                "minimum": 0,
                "description": "Maps to pmset displaysleep."
              },
              "systemSleepMinutes": {
                "type": "integer",
                "minimum": 0,
                "description": "Maps to pmset sleep."
              },
              "diskSleepMinutes": {
                "type": "integer",
                "minimum": 0,
                "description": "Maps to pmset disksleep."
              },
              "processPolicy": {
                "type": "string",
                "description": "Declared process policy. Applying requires explicit target processes."
              }
            },
            "additionalProperties": false
          },
          "targets": {
            "type": "object",
            "required": ["cpuPeak", "gpuPeak", "fanNoise", "transparency"],
            "properties": {
              "cpuPeak": {
                "type": "string"
              },
              "gpuPeak": {
                "type": "string"
              },
              "fanNoise": {
                "type": "string"
              },
              "transparency": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "experimental": {
            "type": "boolean",
            "description": "Experimental profiles require an explicit --experimental flag."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

